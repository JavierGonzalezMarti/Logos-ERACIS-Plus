{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Archivos elegidos por el usuario y faldón recordado por la aplicación",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-exists",
    "fs:allow-remove",
    "fs:create-app-specific-dirs",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPLOCALDATA/logo.*" }]
    },
    "opener:default"
  ]
}
